{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "cr4f2_commondataserviceforapps"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_a_task_changes": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger"
            },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "cr4f2_requesttask",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "cr4f2_status,cr4f2_duedate"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Get_the_sibling_tasks": {
          "type": "OpenApiConnection",
          "runAfter": {},
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords"
            },
            "parameters": {
              "entityName": "cr4f2_requesttasks",
              "$filter": "_cr4f2_request_value eq @{triggerOutputs()?['body/_cr4f2_request_value']} and statecode eq 0",
              "$orderby": "cr4f2_duedate asc",
              "$select": "cr4f2_status,cr4f2_duedate"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Done_count": {
          "type": "Compose",
          "runAfter": {
            "Get_the_sibling_tasks": [
              "Succeeded"
            ]
          },
          "inputs": "@length(filter(outputs('Get_the_sibling_tasks')?['body/value'], equals(item()?['cr4f2_status'], 100000003)))"
        },
        "Only_active_tasks": {
          "type": "If",
          "runAfter": {
            "Done_count": [
              "Succeeded"
            ]
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@triggerOutputs()?['body/statecode']",
                  0
                ]
              }
            ]
          },
          "actions": {
            "Update_the_request_rollup": {
              "type": "OpenApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateRecord"
                },
                "parameters": {
                  "entityName": "cr4f2_requests",
                  "recordId": "@triggerOutputs()?['body/_cr4f2_request_value']",
                  "item/cr4f2_percentcomplete": "@div(mul(outputs('Done_count'), 100), max(1, length(outputs('Get_the_sibling_tasks')?['body/value'])))",
                  "item/cr4f2_nextduedate": "@first(outputs('Get_the_sibling_tasks')?['body/value'])?['cr4f2_duedate']"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "else": {
            "actions": {}
          }
        }
      }
    }
  },
  "schemaVersion": "1.0.0.0"
}
