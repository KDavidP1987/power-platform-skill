table snapshot_status_daily

	/// Records per status on a snapshot day.
	measure 'Snapshot Records' = SUM(snapshot_status_daily[record_count])
		formatString: 0

	column snapshot_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: snapshot_date

	column status
		dataType: string
		summarizeBy: none
		sourceColumn: status

	column record_count
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: record_count

	partition snapshot_status_daily = entity
		mode: directLake
		source
			entityName: snapshot_status_daily
			schemaName: dbo
			expressionSource: DatabaseQuery
