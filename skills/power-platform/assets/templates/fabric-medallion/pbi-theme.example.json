{
  "name": "AppTheme",
  "dataColors": [
    "#005493",
    "#0F766E",
    "#2563EB",
    "#475569",
    "#B45309",
    "#15803D",
    "#0369A1",
    "#B91C1C",
    "#0E7490"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#005493",
  "good": "#15803D",
  "neutral": "#B45309",
  "bad": "#B91C1C",
  "maximum": "#005493",
  "center": "#CBD2D9",
  "minimum": "#FFFFFF",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2933"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2933"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2933"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#52606D"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#1F2933"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#CBD2D9"
              }
            },
            "radius": 6
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "foreground": {
              "solid": {
                "color": "#52606D"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F7FA"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F5F7FA"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F2933"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F5F7FA"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F2933"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F5F7FA"
              }
            }
          }
        ]
      }
    }
  }
}