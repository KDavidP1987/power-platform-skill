{
  "permissions": {
    "allow": [
      "Bash(pac org who*)",
      "Bash(pac solution pack*)",
      "Bash(pac canvas download*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(node .claude/hooks/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node .claude/hooks/preflight.mjs", "timeout": 30, "statusMessage": "Power Platform pre-flight..." } ] }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/check-pa-yaml.mjs", "timeout": 20, "statusMessage": "Checking .pa.yaml for compile-killers..." },
          { "type": "command", "command": "node .claude/hooks/check-standards.mjs", "timeout": 20 },
          { "type": "command", "command": "node .claude/hooks/check-canvas-format.mjs --hook", "timeout": 30, "statusMessage": "Checking text fit and theme tokens..." },
          { "type": "command", "command": "node .claude/hooks/check-canvas-overlap.mjs --hook", "timeout": 30, "statusMessage": "Checking for controls drawn over other controls..." }
        ]
      }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/audit-stop.mjs\"", "timeout": 60, "statusMessage": "End-of-turn audit..." } ] }
    ]
  }
}
