{
  "permissions": {
    "allow": [
      "Bash(pac org who*)",
      "Bash(pac auth list*)",
      "Bash(pac solution pack*)",
      "Bash(pac canvas download*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(node .claude/hooks/*)",
      "Bash(python scripts/canvas-mcp.py*)",
      "Bash(python scripts/check-published-order.py*)",
      "Bash(python scripts/check-drift.py*)",
      "Bash(python scripts/flow-runs.py*)",
      "Bash(python scripts/audit-pages-permissions.py*)",
      "Bash(node scripts/lint-flows.mjs*)",
      "Bash(node scripts/contract-to-walk.mjs*)",
      "Bash(node scripts/canvas-browser.mjs check*)",
      "Bash(node scripts/canvas-browser.mjs walk*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/preflight.mjs\"", "timeout": 30, "statusMessage": "Power Platform pre-flight..." } ] }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-pa-yaml.mjs\"", "timeout": 20, "statusMessage": "Checking .pa.yaml for compile-killers..." },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-standards.mjs\"", "timeout": 20 },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-canvas-format.mjs\" --hook", "timeout": 30, "statusMessage": "Checking text fit, theme tokens and accessibility..." },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-canvas-overlap.mjs\" --hook", "timeout": 30, "statusMessage": "Checking for controls drawn over other controls..." },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/shared-guard.mjs\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/audit-stop.mjs\"", "timeout": 60, "statusMessage": "End-of-turn audit..." } ] }
    ]
  }
}
